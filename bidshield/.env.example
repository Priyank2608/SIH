# Database Connection (SQLite default for standalone run, or PostgreSQL for production)
BIDSHIELD_DATABASE_URL=sqlite:///./storage/bidshield.db
# Generate random secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-random-64-character-hex-password

# Security & Authentication
BIDSHIELD_JWT_SECRET=replace-with-random-64-character-hex-secret
BIDSHIELD_JWT_ALGORITHM=HS256
BIDSHIELD_ACCESS_TOKEN_MINUTES=120

# Operational Modes
BIDSHIELD_DEMO_MODE=true
BIDSHIELD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage & File Processing
BIDSHIELD_STORAGE_DIR=./storage
BIDSHIELD_MAX_UPLOAD_MB=25

# OCR & AI Configuration
BIDSHIELD_OCR_LANGUAGE=eng
BIDSHIELD_OCR_ENGINE=tesseract

# Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
